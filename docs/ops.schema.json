{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDFWorkerz Op",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Produce the COR-03 inspection report for the target document.",
      "properties": {
        "op": {
          "const": "inspect",
          "default": "inspect",
          "title": "Op",
          "type": "string"
        },
        "password": {
          "default": "",
          "title": "Password",
          "type": "string"
        }
      },
      "title": "InspectOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Render one page to PNG bytes (COR-02).",
      "properties": {
        "op": {
          "const": "render_page",
          "default": "render_page",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "default": 0,
          "title": "Page Index",
          "type": "integer"
        },
        "dpi": {
          "default": 150,
          "title": "Dpi",
          "type": "integer"
        }
      },
      "title": "RenderPageOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Every text span on one page, with its style (FNT-01) and text state\n(FNT-02) -- what UI-02's click-to-edit overlay and UI-03's inspector\npanel are both built on (state/checkpoint.json's own plan for them).\nA read-only query, like InspectOp/RenderPageOp: never journaled, so a\ncaller applies it directly rather than through the undo/redo journal\n(see server/app.py's dedicated GET route for this one, matching\nrender_page's own convenience route rather than the generic Op\nendpoint).",
      "properties": {
        "op": {
          "const": "page_spans",
          "default": "page_spans",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "default": 0,
          "title": "Page Index",
          "type": "integer"
        }
      },
      "title": "PageSpansOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Every image placement on one page. Read-only, so -- like\nPageSpansOp -- never journaled; server/app.py serves it from a GET route.",
      "properties": {
        "op": {
          "const": "page_images",
          "default": "page_images",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "default": 0,
          "title": "Page Index",
          "type": "integer"
        }
      },
      "title": "PageImagesOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Add a PNG/JPEG (or anything Pillow reads, re-encoded as PNG) at `rect`.",
      "properties": {
        "op": {
          "const": "insert_image",
          "default": "insert_image",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "rect": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rect",
          "type": "array"
        },
        "image_base64": {
          "title": "Image Base64",
          "type": "string"
        },
        "keep_proportion": {
          "default": true,
          "title": "Keep Proportion",
          "type": "boolean"
        }
      },
      "required": [
        "page_index",
        "rect",
        "image_base64"
      ],
      "title": "InsertImageOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Swap the image at placement `index` for new image data, fitted into the same area.",
      "properties": {
        "op": {
          "const": "replace_image",
          "default": "replace_image",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "image_base64": {
          "title": "Image Base64",
          "type": "string"
        }
      },
      "required": [
        "page_index",
        "index",
        "image_base64"
      ],
      "title": "ReplaceImageOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Move and/or resize the image at placement `index` to exactly `rect`.",
      "properties": {
        "op": {
          "const": "move_image",
          "default": "move_image",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "rect": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rect",
          "type": "array"
        }
      },
      "required": [
        "page_index",
        "index",
        "rect"
      ],
      "title": "MoveImageOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Cut the image at placement `index` down to the part inside `rect`.",
      "properties": {
        "op": {
          "const": "crop_image",
          "default": "crop_image",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "rect": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rect",
          "type": "array"
        }
      },
      "required": [
        "page_index",
        "index",
        "rect"
      ],
      "title": "CropImageOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Remove the image at placement `index` (only that placement).",
      "properties": {
        "op": {
          "const": "delete_image",
          "default": "delete_image",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        }
      },
      "required": [
        "page_index",
        "index"
      ],
      "title": "DeleteImageOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Every link on one page. Read-only, so -- like PageSpansOp -- it's\nnever journaled; server/app.py serves it from a dedicated GET route.",
      "properties": {
        "op": {
          "const": "page_links",
          "default": "page_links",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "default": 0,
          "title": "Page Index",
          "type": "integer"
        }
      },
      "title": "PageLinksOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Add a clickable area at `rect` (PDF points) linking to `uri` or to\n`target_page` -- exactly one of the two.",
      "properties": {
        "op": {
          "const": "add_link",
          "default": "add_link",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "rect": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rect",
          "type": "array"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "target_page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Page"
        }
      },
      "required": [
        "page_index",
        "rect"
      ],
      "title": "AddLinkOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Move and/or retarget the link at `index` (its position in PageLinksOp's list).",
      "properties": {
        "op": {
          "const": "update_link",
          "default": "update_link",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "rect": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rect"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "target_page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Page"
        }
      },
      "required": [
        "page_index",
        "index"
      ],
      "title": "UpdateLinkOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Delete the link at `index`; the text or artwork under it is untouched.",
      "properties": {
        "op": {
          "const": "remove_link",
          "default": "remove_link",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        }
      },
      "required": [
        "page_index",
        "index"
      ],
      "title": "RemoveLinkOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A read-only preview of the font resolution a replacement would use --\nnever draws, redacts or verifies anything, so (like PageSpansOp) it's\nnever journaled; server/app.py calls it directly. `span_index` is\npositional in a fresh `extract_page_spans` call on `page_index`, not a\ntext search (see _span_at).",
      "properties": {
        "op": {
          "const": "preview_text",
          "default": "preview_text",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "span_index": {
          "title": "Span Index",
          "type": "integer"
        },
        "needed_text": {
          "title": "Needed Text",
          "type": "string"
        }
      },
      "required": [
        "page_index",
        "span_index",
        "needed_text"
      ],
      "title": "PreviewTextOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "EDT-02, index-precise: replace exactly the span at `span_index`\n(found the same way PreviewTextOp finds it), never any other span that\nhappens to contain the same text elsewhere on the page -- what UI-02's\nclick-to-edit commit step needs and ReplaceTextOp's text search can't\nguarantee. Journaled normally through the generic ops endpoint, unlike\nits read-only sibling above: this one really does edit the document.",
      "properties": {
        "op": {
          "const": "replace_span_text",
          "default": "replace_span_text",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "span_index": {
          "title": "Span Index",
          "type": "integer"
        },
        "new_text": {
          "title": "New Text",
          "type": "string"
        },
        "require_tier": {
          "default": "approximate",
          "enum": [
            "exact",
            "approximate",
            "fallback"
          ],
          "title": "Require Tier",
          "type": "string"
        },
        "fit": {
          "default": false,
          "title": "Fit",
          "type": "boolean"
        },
        "verify": {
          "default": true,
          "title": "Verify",
          "type": "boolean"
        }
      },
      "required": [
        "page_index",
        "span_index",
        "new_text"
      ],
      "title": "ReplaceSpanTextOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "EDT-07, format painter: give the span at (`target_page_index`,\n`target_span_index`) the font, size, color and spacing of the span at\n(`page_index`, `span_index`), keeping the target's own text. Both spans\nare addressed by index (see _span_at), like ReplaceSpanTextOp, because\nthe UI picks them by clicking, never by searching.",
      "properties": {
        "op": {
          "const": "copy_style",
          "default": "copy_style",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "span_index": {
          "title": "Span Index",
          "type": "integer"
        },
        "target_page_index": {
          "title": "Target Page Index",
          "type": "integer"
        },
        "target_span_index": {
          "title": "Target Span Index",
          "type": "integer"
        },
        "require_tier": {
          "default": "approximate",
          "enum": [
            "exact",
            "approximate",
            "fallback"
          ],
          "title": "Require Tier",
          "type": "string"
        },
        "verify": {
          "default": true,
          "title": "Verify",
          "type": "boolean"
        }
      },
      "required": [
        "page_index",
        "span_index",
        "target_page_index",
        "target_span_index"
      ],
      "title": "CopyStyleOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "EDT-05: move the text block containing the span at `span_index` by\n(`dx`, `dy`) points (MuPDF page space: +x right, +y down), and/or\nre-wrap it to `width` points. Its text and style are unchanged.",
      "properties": {
        "op": {
          "const": "move_text_block",
          "default": "move_text_block",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "span_index": {
          "title": "Span Index",
          "type": "integer"
        },
        "dx": {
          "default": 0.0,
          "title": "Dx",
          "type": "number"
        },
        "dy": {
          "default": 0.0,
          "title": "Dy",
          "type": "number"
        },
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "require_tier": {
          "default": "approximate",
          "enum": [
            "exact",
            "approximate",
            "fallback"
          ],
          "title": "Require Tier",
          "type": "string"
        },
        "verify": {
          "default": true,
          "title": "Verify",
          "type": "boolean"
        }
      },
      "required": [
        "page_index",
        "span_index"
      ],
      "title": "MoveTextBlockOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "EDT-02: find text (literal or regex) and replace it, matching the original style.",
      "properties": {
        "match": {
          "title": "Match",
          "type": "string"
        },
        "mode": {
          "default": "literal",
          "enum": [
            "literal",
            "regex"
          ],
          "title": "Mode",
          "type": "string"
        },
        "case_sensitive": {
          "default": true,
          "title": "Case Sensitive",
          "type": "boolean"
        },
        "page_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Index"
        },
        "require_tier": {
          "default": "approximate",
          "enum": [
            "exact",
            "approximate",
            "fallback"
          ],
          "title": "Require Tier",
          "type": "string"
        },
        "fit": {
          "default": false,
          "title": "Fit",
          "type": "boolean"
        },
        "verify": {
          "default": true,
          "title": "Verify",
          "type": "boolean"
        },
        "op": {
          "const": "replace_text",
          "default": "replace_text",
          "title": "Op",
          "type": "string"
        },
        "replacement": {
          "default": "",
          "title": "Replacement",
          "type": "string"
        }
      },
      "required": [
        "match"
      ],
      "title": "ReplaceTextOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "EDT-04: find and remove text, closing the gap in its style-matched span.",
      "properties": {
        "match": {
          "title": "Match",
          "type": "string"
        },
        "mode": {
          "default": "literal",
          "enum": [
            "literal",
            "regex"
          ],
          "title": "Mode",
          "type": "string"
        },
        "case_sensitive": {
          "default": true,
          "title": "Case Sensitive",
          "type": "boolean"
        },
        "page_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Index"
        },
        "require_tier": {
          "default": "approximate",
          "enum": [
            "exact",
            "approximate",
            "fallback"
          ],
          "title": "Require Tier",
          "type": "string"
        },
        "fit": {
          "default": false,
          "title": "Fit",
          "type": "boolean"
        },
        "verify": {
          "default": true,
          "title": "Verify",
          "type": "boolean"
        },
        "op": {
          "const": "delete_text",
          "default": "delete_text",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "match"
      ],
      "title": "DeleteTextOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "EDT-06: change the size and/or color of text that already matches, leaving its\nwording unchanged.",
      "properties": {
        "op": {
          "const": "restyle_text",
          "default": "restyle_text",
          "title": "Op",
          "type": "string"
        },
        "match": {
          "title": "Match",
          "type": "string"
        },
        "mode": {
          "default": "literal",
          "enum": [
            "literal",
            "regex"
          ],
          "title": "Mode",
          "type": "string"
        },
        "case_sensitive": {
          "default": true,
          "title": "Case Sensitive",
          "type": "boolean"
        },
        "page_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Index"
        },
        "size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "color": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "require_tier": {
          "default": "approximate",
          "enum": [
            "exact",
            "approximate",
            "fallback"
          ],
          "title": "Require Tier",
          "type": "string"
        },
        "verify": {
          "default": true,
          "title": "Verify",
          "type": "boolean"
        }
      },
      "required": [
        "match"
      ],
      "title": "RestyleTextOp",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "EDT-03: add new text near an existing span, matching its style (or an\nexplicit override) -- nothing existing is touched.",
      "properties": {
        "op": {
          "const": "insert_text",
          "default": "insert_text",
          "title": "Op",
          "type": "string"
        },
        "page_index": {
          "title": "Page Index",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "position": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "reference_match": {
          "title": "Reference Match",
          "type": "string"
        },
        "reference_case_sensitive": {
          "default": true,
          "title": "Reference Case Sensitive",
          "type": "boolean"
        },
        "require_tier": {
          "default": "approximate",
          "enum": [
            "exact",
            "approximate",
            "fallback"
          ],
          "title": "Require Tier",
          "type": "string"
        },
        "verify": {
          "default": true,
          "title": "Verify",
          "type": "boolean"
        }
      },
      "required": [
